# Copy this file to .env and fill in your values.

DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id
CLIENT_SECRET=your-client-secret

BOT_NAME=DingDingDong
DEFAULT_PREFIX=!
EMBED_COLOR=#8B5CF6

MAX_QUEUE=500
MAX_PLAYLIST_TRACKS=500
MAX_PLAYLISTS_PER_USER=20
PLAYLIST_URL_LIMIT=100
SEARCH_RESULTS=8

IDLE_LEAVE_SECONDS=600
EMPTY_CHANNEL_SECONDS=180

# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# YouTube extraction: empty = cookie-less mode (client fallbacks + automatic
# SoundCloud rescue when YouTube bot-walls). Or a browser name (firefox/edge/
# chrome) / "auto" (=firefox) to read that browser's live YouTube session —
# no manual cookie export, nothing to refresh by hand.
YTDLP_COOKIES_FROM_BROWSER=
# On a hosting panel (no browser around): upload a cookies.txt (export with a
# "Get cookies.txt" browser extension), keep it next to main.py, and put the
# file name/path here. Only needs refreshing if YouTube blocks again.
YTDLP_COOKIE_FILE=

# ---- AI (Groq primary, Google Gemini fallback) ----
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_GOOGLE_MODEL=gemini-3.8-flash
